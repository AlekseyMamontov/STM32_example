# ESP32-S3 images are built with MCUboot through sysbuild (same as esp32s3_box3).
# Kconfig.<board> is shared with the sysbuild Kconfig tree, so the BOARD_* symbol is usable here.
choice BOOTLOADER
	default BOOTLOADER_MCUBOOT if BOARD_MULT_CANBRIDGE_ESP32S3_PROCPU
endchoice
